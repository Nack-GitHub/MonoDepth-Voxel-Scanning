# ---- Data & heavy artifacts: NEVER commit ----
data/*
!data/README.md
outputs/*
!outputs/.gitkeep
# roomscan_web work dir (uploads + meshes)
outputs/web/
# Results: commit config + metrics (small), ignore meshes/arrays (large)
experiments/results/**/*.ply
experiments/results/**/*.obj
experiments/results/**/*.glb
experiments/results/**/*.npy
experiments/results/**/*.npz
experiments/results/**/*.png
# Training runs: commit config.yaml + log.jsonl only; weights go to HF Hub (ADR-013)
experiments/training/*/best/
experiments/training/*/last/
experiments/training/*.out
paper/figures/**/*.ply
# LaTeX build
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.log
paper/latex/*.out
paper/latex/*.synctex.gz

# ---- Model weights ----
checkpoints/
*.pth
*.pt
*.safetensors
*.onnx

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editors ----
.DS_Store
.vscode/
.idea/
